"strumming":{"note":"Default practice patterns for Level 4 songs; not checked against the recording.","source":"level-default","patterns":[{"id":"folk-strum","name":"Start: D — D U — U D U","counts":["1","&","2","&","3","&","4","&"],"strokes":["D","—","D","U","—","U","D","U"],"description":"Keep the down-up pendulum going; miss the strings on the \"&\" of 1 and on 3. A common pop and rock strum."},{"id":"anchor-1-3","name":"Next: anchor beats 1 and 3","counts":["1","&","2","&","3","&","4","&"],"strokes":["D","—","D","U","D","—","D","U"],"description":"Down on every count with an up after 2 and 4. Fewer strokes keep the barre hand settled through changes."}]},
